      "objective": "Check whether the smoke run is threshold-limited.",
      "hypothesis": "Lowering the candidate threshold should expose whether zero recall is caused by candidate filtering or coordinate alignment.",
      "tags": ["smoke", "fixed_split", "native_frame", "diagnostic"],
      "claims": ["threshold_policy"],
